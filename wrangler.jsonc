{
  // Cloudflare Worker for the Clark Family Tree.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clark-family-tree",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clark-family-tree",
      "database_id": "ae542dae-279b-4c51-9c2e-abc920cb1d91",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
