{
  // Cloudflare Worker for the Clark Family Tree.
  // The pages in public/ are bundled into the Worker as text (see "rules"), so nothing else needs uploading.
  "name": "clark-family-tree",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "rules": [
    { "type": "Text", "globs": ["**/*.html", "**/*.css", "**/public/*.js"], "fallthrough": false }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clark-family-tree",
      "database_id": "ae542dae-279b-4c51-9c2e-abc920cb1d91",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
